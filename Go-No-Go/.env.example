# GO / NO-GO (GNG) — Optional Cloud Persistence & Server AI Advisor Client Environment Variables
# Note: The application runs offline-first using LocalStorage if Supabase vars are omitted.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional server-side AI narrative endpoint (never put provider API keys in client env)
VITE_ADVISOR_ENDPOINT=

# Meteomatics Weather API is SERVER-SIDE ONLY (Cloudflare Pages Secrets / .dev.vars).
# NEVER prefix Meteomatics credentials with VITE_ and NEVER commit real secrets to Git.
# Configure these in Cloudflare Pages -> Settings -> Environment Variables (Encrypted Secret):
#   METEOMATICS_USERNAME
#   METEOMATICS_PASSWORD
